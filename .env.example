# SankatBrigade — optional AI language layer.
#
# Copy to `.env` for Docker Compose, or to `.dev.vars` for local Cloudflare
# testing. NEVER commit a file containing a real key: .gitignore already
# excludes .env, .env.* and .dev.vars.
#
# On Cloudflare Pages these are set in the dashboard instead:
#   Settings -> Variables and secrets -> add, and mark AI_API_KEY as a Secret.
#
# With none of this set, the app runs its deterministic assistant and nothing
# breaks — the AI layer is an enhancement, never a dependency.

# anthropic | gemini | openai_compatible | mock
AI_PROVIDER=mock

# The secret. Read only on the server; never sent to the browser.
AI_API_KEY=

# Optional model override. Defaults per provider:
#   anthropic          -> claude-haiku-4-5-20251001
#   gemini             -> gemini-3.5-flash-lite
#   openai_compatible  -> gpt-4o-mini
AI_MODEL=

# Only for openai_compatible providers (Groq, OpenRouter, Together, …), e.g.
#   https://api.groq.com/openai/v1
AI_BASE_URL=
